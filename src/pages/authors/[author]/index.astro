---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import ArchivePage from "@components/blog/ArchivePage.astro";
import { siteConfig } from "@config/site";
import { entryIdToSlug, slugify } from "@utils/slug";
import { getPublishedAuthors, getPublishedPosts, sortPostsByDate } from "@utils/content";
import { resolveAuthor, warnUnknownAuthor } from "@utils/authors";

export async function getStaticPaths() {
    const posts = await getPublishedPosts();

    // Get all author content
    const authorEntries = await getPublishedAuthors();

    // Get all unique authors referenced by posts
    const authors = [...new Set(posts.flatMap((post) => post.data.authors || []))];

    const paths = [];
    for (const author of authors) {
        // Resolve by entry id; unknown references warn and skip instead of rendering an empty bio
        const authorDetails = resolveAuthor(author, authorEntries);
        if (!authorDetails) {
            warnUnknownAuthor(author);
            continue;
        }

        // Filter posts by author
        const authorPosts = sortPostsByDate(
            posts.filter((post) => post.data.authors && post.data.authors.includes(author))
        );

        const authorSlug = slugify(entryIdToSlug(authorDetails));
        paths.push({
            params: { author: authorSlug },
            props: {
                author,
                authorDetails,
                slug: authorSlug,
                posts: authorPosts,
            },
        });
    }

    return paths;
}

const { author, authorDetails, slug, posts } = Astro.props;
const AuthorContent = authorDetails ? (await render(authorDetails)).Content : null;

// Format the author name for display
const formattedAuthor = author
    .split(" ")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(" ");

// Display the resolved entry title; frontmatter references are entry ids, not names
const displayName = authorDetails ? authorDetails.data.title : formattedAuthor;
---

<ArchivePage
    title={`Posts by ${displayName} - ${siteConfig.title}`}
    description={`Browse all posts written by ${displayName}`}
    heading={`Author: ${displayName}`}
    subline={`${posts.length} ${posts.length === 1 ? "post" : "posts"} by this author`}
    basePath={`/authors/${slug}`}
    posts={posts}
    page={1}
    indexable={!siteConfig.noindex.authors}
    emptyMessage="No posts found by this author."
>
    <Fragment slot="lead">
        {authorDetails && (
            <div class="mb-12 bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden border border-gray-100 dark:border-gray-700">
                <div class="p-6 md:p-8">
                    <div class="flex flex-col md:flex-row gap-8">
                        {authorDetails.data.image && (
                            <div class="flex-shrink-0">
                                <div class="w-32 h-32 md:w-40 md:h-40 rounded-full overflow-hidden border-4 border-white dark:border-gray-700 shadow-lg">
                                    <img
                                        src={authorDetails.data.image}
                                        alt={authorDetails.data.title}
                                        width="160"
                                        height="160"
                                        loading="lazy"
                                        decoding="async"
                                        class="w-full h-full object-cover"
                                    />
                                </div>

                                {authorDetails.data.social && (
                                    <div class="mt-4 flex justify-center gap-3">
                                        {authorDetails.data.social.twitter && (
                                            <a href={authorDetails.data.social.twitter} target="_blank" rel="noopener noreferrer"
                                                aria-label={"Follow " + authorDetails.data.title + " on Twitter"}
                                                class="text-gray-500 hover:text-blue-500 dark:text-gray-400 dark:hover:text-blue-400 transition-colors">
                                                <Icon name="mdi:twitter" class="w-6 h-6" />
                                            </a>
                                        )}
                                        {authorDetails.data.social.facebook && (
                                            <a href={authorDetails.data.social.facebook} target="_blank" rel="noopener noreferrer"
                                                aria-label={"Follow " + authorDetails.data.title + " on Facebook"}
                                                class="text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 transition-colors">
                                                <Icon name="mdi:facebook" class="w-6 h-6" />
                                            </a>
                                        )}
                                        {authorDetails.data.social.instagram && (
                                            <a href={authorDetails.data.social.instagram} target="_blank" rel="noopener noreferrer"
                                                aria-label={"Follow " + authorDetails.data.title + " on Instagram"}
                                                class="text-gray-500 hover:text-pink-600 dark:text-gray-400 dark:hover:text-pink-400 transition-colors">
                                                <Icon name="mdi:instagram" class="w-6 h-6" />
                                            </a>
                                        )}
                                    </div>
                                )}
                            </div>
                        )}

                        <div class="grow">
                            <div class="prose prose-lg dark:prose-invert max-w-none">
                                {AuthorContent && <AuthorContent />}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        )}
    </Fragment>
</ArchivePage>
