---
import ArchivePage from "@components/blog/ArchivePage.astro";
import { siteConfig } from "@config/site";
import { getPublishedPosts, sortPostsByDate } from "@utils/content";
import { getPaginatedPageNumbers } from "@utils/pagination";

export async function getStaticPaths() {
    const posts = sortPostsByDate(await getPublishedPosts());

    // Page 1 lives on the index route; this sibling renders 2..totalPages.
    return getPaginatedPageNumbers(posts.length, siteConfig.postsPerPage).map((page) => ({
        params: { page: page.toString() },
        props: { posts, page },
    }));
}

const { posts, page } = Astro.props;
---

<ArchivePage
    title={`Blog - Page ${page} - ${siteConfig.title}`}
    description={`Explore our articles, tutorials, and insights - Page ${page}`}
    heading="Blog"
    subline="Explore our articles, tutorials, and insights"
    basePath="/blog"
    posts={posts}
    page={page}
    indexable={false}
/>
