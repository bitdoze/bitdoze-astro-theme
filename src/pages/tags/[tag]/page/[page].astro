---
import ArchivePage from "@components/blog/ArchivePage.astro";
import { siteConfig } from "@config/site";
import { normalizeTaxonomy, taxonomySlug } from "@utils/slug";
import { getPublishedPosts, sortPostsByDate } from "@utils/content";
import { getPaginatedPageNumbers } from "@utils/pagination";

export async function getStaticPaths() {
    const posts = await getPublishedPosts();

    // Group by normalized taxonomy identity so case/punctuation variants
    // ("Astro" vs "astro") share one route and one post set; the first raw
    // label is kept for display.
    const tags = normalizeTaxonomy(posts.flatMap((post) => post.data.tags || []));

    return tags.flatMap(({ slug, label }) => {
        const tagPosts = sortPostsByDate(
            posts.filter((post) =>
                (post.data.tags || []).some((tag) => taxonomySlug(tag) === slug)
            )
        );

        // Page 1 lives on the index route; this sibling renders 2..totalPages.
        return getPaginatedPageNumbers(tagPosts.length, siteConfig.postsPerPage).map((page) => ({
            params: {
                tag: slug,
                page: page.toString(),
            },
            props: {
                tag: label,
                slug,
                posts: tagPosts,
                page,
            },
        }));
    });
}

const { tag, slug, posts, page } = Astro.props;
const formattedTag = tag.charAt(0).toUpperCase() + tag.slice(1);
---

<ArchivePage
    title={`Posts tagged with ${formattedTag} - Page ${page} - ${siteConfig.title}`}
    description={`Browse posts tagged with ${formattedTag} - Page ${page}`}
    heading={`Tag: #${formattedTag}`}
    subline={`${posts.length} ${posts.length === 1 ? "post" : "posts"} with this tag`}
    basePath={`/tags/${slug}`}
    posts={posts}
    page={page}
    indexable={false}
    emptyMessage="No posts found with this tag."
/>
