---
import { Icon } from "astro-icon/components";
import Hero from "@components/widgets/Hero.astro";
import Layout from "@layouts/Layout.astro";
import PostCard from "@components/blog/PostCard.astro";
import FeaturedPosts from "@components/blog/FeaturedPosts.astro";
import PopularTopics from "@components/blog/PopularTopics.astro";
import LearningPaths from "@components/blog/LearningPaths.astro";
import SectionHeader from "@components/blog/SectionHeader.astro";
import { siteConfig } from "@config/site";
import { getPublishedPosts, sortPostsByDate } from "@utils/content";
import { getPostSlug, withBase } from "@utils/slug";
import { buildLearningPaths } from "@utils/learningPaths";

// Get all blog posts and sort by date (newest first)
const sortedPosts = sortPostsByDate(await getPublishedPosts());

// Each homepage surface owns a distinct slice of the archive so no post
// renders twice: the hero takes the newest post, Featured Posts shows the
// editor's picks, Learning Paths owns the series, and the Latest grid shows
// the newest remaining posts.
const featuredPost = sortedPosts[0];
const featuredSlug = featuredPost ? getPostSlug(featuredPost) : undefined;
const seriesSlugs = sortedPosts
  .filter((post) => post.data.series)
  .map((post) => getPostSlug(post));

// Flagged posts, newest first. The hero already spotlights the newest post
// overall, so it is dropped here to keep the grid free of repeats.
const pickedPosts = sortedPosts
  .filter((post) => post.data.featured && getPostSlug(post) !== featuredSlug)
  .slice(0, siteConfig.homepage.featured.limit);
const pickedSlugs = pickedPosts.map((post) => getPostSlug(post));

const latestPosts = sortedPosts
  .filter((post) => {
    const slug = getPostSlug(post);
    return (
      slug !== featuredSlug &&
      !seriesSlugs.includes(slug) &&
      !pickedSlugs.includes(slug)
    );
  })
  .slice(0, siteConfig.homepage.latest.limit);

const learningPaths = buildLearningPaths(sortedPosts, [
  ...(featuredSlug ? [featuredSlug] : []),
  ...pickedSlugs,
  ...latestPosts.map((post) => getPostSlug(post)),
]);

// Hero + Featured Posts render above Popular Topics; its columns prefer other
// posts first and then backfill per tag.
const abovePopularSlugs = [
  ...(featuredSlug ? [featuredSlug] : []),
  ...pickedSlugs,
];

const stats = {
  guides: sortedPosts.length,
  topics: new Set(sortedPosts.flatMap((post) => post.data.categories ?? [])).size,
  authors: new Set(sortedPosts.flatMap((post) => post.data.authors ?? [])).size,
};

const { showFeaturedPosts, showTaxonomyCards, showPopularTopics, latest, explore } = siteConfig.homepage;
---

<Layout
  title={siteConfig.title}
  description={siteConfig.description}
  wideContent={true}
>
  <div class="w-full pb-8">
    <!-- Hero Section -->
    <Hero post={featuredPost} stats={stats} hasLearningPaths={learningPaths.length > 0} />

    <!-- Featured Posts Section (editor's picks, deduped against the hero) -->
    {showFeaturedPosts && <FeaturedPosts posts={pickedPosts} />}

    <!-- Popular Topics Section (prefers posts not shown above, backfills per topic) -->
    {showPopularTopics && <PopularTopics excludeSlugs={abovePopularSlugs} />}

    <!-- Latest Articles Section -->
    {latestPosts.length > 0 && (
      <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
        <SectionHeader
          title={latest.title}
          actionLabel={latest.actionLabel}
          actionHref={withBase("/blog/")}
        />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )}

    <!-- Learning Paths Section (series + top topics, with entry points) -->
    <LearningPaths paths={learningPaths} />

    <!-- Explore Section (compact taxonomy row) -->
    {showTaxonomyCards && (
      <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
        <SectionHeader
          title={explore.title}
          description={explore.description}
        />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {explore.cards.map((card) => (
            <a
              href={withBase(card.href)}
              class="flex items-center gap-4 p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 border border-gray-200 dark:border-gray-700"
            >
              <Icon name={card.icon} class="h-8 w-8 shrink-0 text-accent-600 dark:text-accent-400" />
              <div>
                <h3 class="text-base font-semibold text-gray-900 dark:text-white">{card.title}</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">{card.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
