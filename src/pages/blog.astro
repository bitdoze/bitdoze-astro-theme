---
import ArchivePage from "@components/blog/ArchivePage.astro";
import { siteConfig } from "@config/site";
import { getPublishedPosts, sortPostsByDate } from "@utils/content";

const posts = sortPostsByDate(await getPublishedPosts());
const page = siteConfig.pages.blog;
---

<ArchivePage
    title={`${page.title} - ${siteConfig.title}`}
    description={page.description}
    heading={page.title}
    subline={page.subline}
    basePath="/blog"
    posts={posts}
    page={1}
    indexable={true}
/>
