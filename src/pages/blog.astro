---
import ArchivePage from "@components/blog/ArchivePage.astro";
import { siteConfig } from "@config/site";
import { getPublishedPosts, sortPostsByDate } from "@utils/content";

const posts = sortPostsByDate(await getPublishedPosts());
---

<ArchivePage
    title={`Blog - ${siteConfig.title}`}
    description="Explore our latest articles, tutorials, and insights"
    heading="Blog"
    subline="Explore our latest articles, tutorials, and insights"
    basePath="/blog"
    posts={posts}
    page={1}
    indexable={true}
/>
