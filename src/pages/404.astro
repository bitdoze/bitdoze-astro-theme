---
import Layout from '@layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@config/site';
import { withBase } from '@utils/slug';

const page = siteConfig.pages.notFound;
---

<Layout title={page.title} description={page.description} indexable={false}>
  <div class="w-full py-16 flex flex-col items-center justify-center text-center px-4">
    <div class="max-w-md">
      <Icon name="mdi:alert-circle-outline" class="w-24 h-24 text-accent-600 dark:text-accent-400 mx-auto mb-6" />
      
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        {page.heading}
      </h1>
      
      <h2 class="text-2xl md:text-3xl font-semibold text-gray-800 dark:text-gray-200 mb-6">
        {page.subheading}
      </h2>
      
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
        {page.message}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={withBase("/")} 
          class="px-6 py-3 bg-accent-600 hover:bg-accent-700 text-white rounded-md transition-colors duration-300 flex items-center justify-center"
        >
          <Icon name="mdi:home" class="w-5 h-5 mr-2" />
          {page.homeLabel}
        </a>
        
        <a 
          href={withBase("/blog/")} 
          class="px-6 py-3 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-800 dark:text-gray-200 rounded-md transition-colors duration-300 flex items-center justify-center"
        >
          <Icon name="mdi:book-open" class="w-5 h-5 mr-2" />
          {page.blogLabel}
        </a>
      </div>
    </div>
  </div>
</Layout>
