---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@config/site";
import { normalizeTaxonomy, taxonomySlug, withBase } from "@utils/slug";
import { getPublishedPosts } from "@utils/content";

const posts = await getPublishedPosts();

// Dedupe by route slug so "Tutorials"/"tutorials" render one card with a
// combined count; the first raw label is kept for display.
const categories = normalizeTaxonomy(posts.flatMap((post) => post.data.categories || []));
const categoryCounts = categories
    .map(({ slug, label }) => ({
        name: label,
        count: posts.filter((post) =>
            (post.data.categories || []).some((category) => taxonomySlug(category) === slug)
        ).length,
        slug,
    }))
    .sort((a, b) => b.count - a.count); // Sort by post count (descending)
---

<Layout
    title={`Categories - ${siteConfig.title}`}
    description="Browse all categories of posts on our blog"
    indexable={!siteConfig.noindex.categories}
>
    <div class="w-full py-8">
        <header class="mb-10">
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
                Categories
            </h1>
            <p class="text-lg text-gray-700 dark:text-gray-300">
                Browse posts by category
            </p>
        </header>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {categoryCounts.map(({ name, count, slug }) => (
                <a
                    href={withBase(`/categories/${slug}/`)}
                    class="flex items-center justify-between p-5 bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow border border-gray-200 dark:border-gray-700"
                >
                    <div class="flex items-center">
                        <Icon name="mdi:folder" class="w-6 h-6 text-blue-600 dark:text-blue-400 mr-3" />
                        <span class="font-medium text-gray-900 dark:text-white">
                            {name.charAt(0).toUpperCase() + name.slice(1)}
                        </span>
                    </div>
                    <span class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs font-medium px-2.5 py-0.5 rounded-full">
                        {count} {count === 1 ? "post" : "posts"}
                    </span>
                </a>
            ))}
        </div>

        {categoryCounts.length === 0 && (
            <div class="text-center py-12">
                <p class="text-gray-600 dark:text-gray-400">No categories found.</p>
            </div>
        )}
    </div>
</Layout>
