---
import ArchivePage from "@components/blog/ArchivePage.astro";
import { siteConfig } from "@config/site";
import { normalizeTaxonomy, taxonomySlug } from "@utils/slug";
import { getPublishedPosts, sortPostsByDate } from "@utils/content";
import { getPaginatedPageNumbers } from "@utils/pagination";

export async function getStaticPaths() {
    const posts = await getPublishedPosts();

    // Group by normalized taxonomy identity so case/punctuation variants
    // ("Tutorials" vs "tutorials") share one route and one post set; the
    // first raw label is kept for display.
    const categories = normalizeTaxonomy(posts.flatMap((post) => post.data.categories || []));

    return categories.flatMap(({ slug, label }) => {
        const categoryPosts = sortPostsByDate(
            posts.filter((post) =>
                (post.data.categories || []).some((category) => taxonomySlug(category) === slug)
            )
        );

        // Page 1 lives on the index route; this sibling renders 2..totalPages.
        return getPaginatedPageNumbers(categoryPosts.length, siteConfig.postsPerPage).map((page) => ({
            params: {
                category: slug,
                page: page.toString(),
            },
            props: {
                category: label,
                slug,
                posts: categoryPosts,
                page,
            },
        }));
    });
}

const { category, slug, posts, page } = Astro.props;
const formattedCategory = category.charAt(0).toUpperCase() + category.slice(1);
---

<ArchivePage
    title={`${formattedCategory} - Page ${page} - ${siteConfig.title}`}
    description={`Browse posts in the ${formattedCategory} category - Page ${page}`}
    heading={`Category: ${formattedCategory}`}
    subline={`${posts.length} ${posts.length === 1 ? "post" : "posts"} in this category`}
    basePath={`/categories/${slug}`}
    posts={posts}
    page={page}
    indexable={false}
    emptyMessage="No posts found in this category."
/>
