---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { formatDate } from '@utils/date';
import { getPostUrl, taxonomySlug, withBase } from '@utils/slug';
import SeriesBadge from './SeriesBadge.astro';

const { post } = Astro.props;
const { title, description, image, imageFit, date, categories, authors, series } = post.data;

const postUrl = getPostUrl(post);

// Check if post is part of a series
const isPartOfSeries = Boolean(series);

// Coverless posts render a text-only card; "contain" letterboxes the cover instead of cropping it
const coverWrapClass = `block overflow-hidden aspect-video ${imageFit === "contain" ? "bg-gray-100 dark:bg-gray-900" : ""}`;
const coverImageClass = imageFit === "contain"
  ? "w-full h-full object-contain"
  : "w-full h-full object-cover transition-transform duration-400 hover:scale-105";
const titleClass = image
  ? "text-xl font-bold mb-2 text-gray-900 dark:text-white line-clamp-2"
  : "text-2xl font-bold mb-2 text-gray-900 dark:text-white line-clamp-3";
---

<article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden transition-transform duration-400 hover:transform hover:scale-[1.02]" >
  <!-- Post Image -->
  {image && (
    <a href={postUrl} data-astro-prefetch class={coverWrapClass}>
      <Image 
        src={image} 
        alt={title} 
        class={coverImageClass}
        width={640}
        height={360}
        widths={[360, 640, 960]}
        sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  
  <div class="p-5">
    <div class="flex flex-wrap gap-2 mb-2 items-center justify-between">
      <!-- Categories -->
      {categories && categories.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {categories.map((category: string) => (
            <a 
              href={withBase(`/categories/${taxonomySlug(category)}/`)}
              class="text-xs font-medium px-2 py-1 bg-accent-100 dark:bg-accent-900 text-accent-700 dark:text-accent-300 rounded-full hover:bg-accent-200 dark:hover:bg-accent-800 transition-colors"
            >
              {category}
            </a>
          ))}
        </div>
      )}
      
      <!-- Series Badge (if part of a series) -->
      {isPartOfSeries && (
        <SeriesBadge 
          seriesName={series.name}
          seriesPosition={series.position}
          size="sm"
        />
      )}
    </div>
    
    <!-- Title -->
    <h2 class={titleClass}>
      <a href={postUrl} data-astro-prefetch class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
        {title}
      </a>
    </h2>
    
    <!-- Description -->
    {description && (
      <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-3">
        {description}
      </p>
    )}
    
    <div class="flex items-center justify-between mt-4 text-sm text-gray-500 dark:text-gray-400">
      <!-- Author -->
      {authors && authors.length > 0 && (
        <div class="flex items-center">
          <Icon name="mdi:account" class="w-4 h-4 mr-1" />
          <span>{authors[0]}</span>
        </div>
      )}
      
      <!-- Date -->
      {date && (
        <div class="flex items-center">
          <Icon name="mdi:calendar" class="w-4 h-4 mr-1" />
          <time datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
        </div>
      )}
    </div>
  </div>
</article>
