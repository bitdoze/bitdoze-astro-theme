---
import { Image } from 'astro:assets';
import { formatDateShort } from '@utils/date';
import { getPostUrl, taxonomySlug, withBase } from '@utils/slug';
import SeriesBadge from './SeriesBadge.astro';

const { post } = Astro.props;
const { title, description, image, imageFit, date, categories, authors, series } = post.data;

const postUrl = getPostUrl(post);

// Check if post is part of a series
const isPartOfSeries = Boolean(series);
// One chip max: the first category moves to the meta row, so the top of the
// card belongs to the series label and the title alone.
const primaryCategory = categories?.[0];

// Coverless posts render a text-only card; "contain" letterboxes the cover instead of cropping it
const isContained = imageFit === "contain";
const coverWrapClass = `block overflow-hidden aspect-video ${isContained ? "bg-gray-50 dark:bg-gray-900" : ""}`;
const coverImageClass = `w-full h-full transition-[filter] duration-300 group-hover/card:brightness-105 ${isContained ? "object-contain" : "object-cover"}`;
const titleClass = image
  ? "text-xl font-bold mb-2 text-gray-900 dark:text-white line-clamp-2"
  : "text-2xl font-bold mb-2 text-gray-900 dark:text-white line-clamp-3";
---

<article class="group/card flex h-full flex-col rounded-lg border border-gray-200 bg-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-gray-700 dark:bg-gray-800 overflow-hidden">
  <!-- Post Image -->
  {image && (
    <a href={postUrl} data-astro-prefetch class={coverWrapClass}>
      <Image 
        src={image} 
        alt={title}
        class={coverImageClass}
        width={640}
        height={360}
        widths={[320, 480, 640]}
        sizes="(max-width: 480px) 480px, (max-width: 768px) 640px, (max-width: 1024px) 480px, 640px"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}
  
  <div class="flex flex-1 flex-col p-5">
    <!-- Series label above the title; category lives in the meta row -->
    {isPartOfSeries && series && (
      <div class="mb-3">
        <SeriesBadge 
          seriesName={series.name}
          seriesPosition={series.position}
          size="sm"
        />
      </div>
    )}
    
    <!-- Title -->
    <h2 class={titleClass}>
      <a href={postUrl} data-astro-prefetch class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
        {title}
      </a>
    </h2>
    
    <!-- Description -->
    {description && (
      <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300 mb-4 line-clamp-3">
        {description}
      </p>
    )}

    <!-- One text-first meta row: author · category, date pinned right. Long
         values truncate with a title tooltip instead of wrapping. -->
    <div class="mt-auto flex min-w-0 items-center gap-x-2 border-t border-gray-100 pt-3 text-xs text-gray-500 dark:border-gray-700/70 dark:text-gray-400">
      {authors && authors.length > 0 && (
        <span class="min-w-0 truncate font-medium text-gray-600 dark:text-gray-300" title={authors[0]}>
          {authors[0]}
        </span>
      )}

      {authors && authors.length > 0 && primaryCategory && (
        <span aria-hidden="true" class="shrink-0 text-gray-300 dark:text-gray-600">&middot;</span>
      )}

      {primaryCategory && (
        <a
          href={withBase(`/categories/${taxonomySlug(primaryCategory)}/`)}
          title={primaryCategory}
          class="min-w-0 truncate font-medium text-accent-700 transition-colors hover:text-accent-800 dark:text-accent-300 dark:hover:text-accent-200"
        >
          {primaryCategory}
        </a>
      )}
      
      {date && (
        <time
          datetime={date.toISOString()}
          class="ml-auto shrink-0 whitespace-nowrap"
        >
          {formatDateShort(date)}
        </time>
      )}
    </div>
  </div>
</article>
