---
import PostCard from "./PostCard.astro";
import SectionHeader from "./SectionHeader.astro";
import type { PostEntry } from "@utils/content";

interface Props {
  /** Posts flagged `featured: true`, newest first and already deduped. */
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <SectionHeader
      title="Featured Posts"
      description="Hand-picked guides worth starting with."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
)}
