---
import PostCard from "./PostCard.astro";
import type { PostEntry } from "@utils/content";

interface Props {
  /** Posts flagged `featured: true`, newest first and already deduped. */
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <div class="mb-8">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">Featured Posts</h2>
      <p class="mt-2 text-base text-gray-600 dark:text-gray-400">
        Hand-picked guides worth starting with.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
)}
