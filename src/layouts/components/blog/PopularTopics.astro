---
import { Image } from "astro:assets";
import { getPostUrl, getPostSlug, normalizeTaxonomy, taxonomySlug, withBase } from "@utils/slug";
import { getPublishedPosts, sortPostsByDate } from "@utils/content";
import { formatDate } from "@utils/date";

export interface Props {
    tags?: string[];
    postsPerTag?: number;
    /** Slugs of posts already shown elsewhere on the page; excluded here to avoid repeats. */
    excludeSlugs?: string[];
}

const { tags = ["Jamstack", "astro", "ai"], postsPerTag = 5, excludeSlugs = [] } = Astro.props;

// Get all posts
const sortedPosts = sortPostsByDate(await getPublishedPosts());

// Collapse duplicate tag labels into route identities ("astro"/"Astro" merge).
// Each column prefers posts not already shown in the hero or Latest grid, but
// backfills from shown posts when the tag would otherwise come up empty: on a
// small blog a hollow section is worse than a repeat. Tags with no posts at
// all are dropped entirely.
const shownSlugs = new Set(excludeSlugs);
const tagPosts = normalizeTaxonomy(tags)
    .map(({ slug, label }) => {
        const matching = sortedPosts.filter((post) =>
            post.data.tags?.some((t: string) => taxonomySlug(t) === slug),
        );
        const fresh = matching.filter((post) => !shownSlugs.has(getPostSlug(post)));
        const posts = [...fresh, ...matching.filter((post) => shownSlugs.has(getPostSlug(post)))].slice(
            0,
            postsPerTag,
        );
        return { slug, label, posts };
    })
    .filter(({ posts }) => posts.length > 0);
---

{tagPosts.length > 0 && (
<section
    class="mt-16 border-y border-gray-200 bg-gray-50 py-14 dark:border-gray-700 dark:bg-gray-800/40"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10 flex items-end justify-between gap-4">
            <div>
                <h2
                    class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-white"
                >
                    Popular Topics
                </h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    The stacks readers come here for
                </p>
            </div>
        </div>
        <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8 lg:gap-12">
            {
                tagPosts.map(({ slug, label, posts }) => (
                    <div>
                        <div class="flex items-center gap-2 border-b-2 border-accent-600 pb-3 dark:border-accent-400">
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white capitalize">
                                {label}
                            </h3>
                            <span class="rounded-full bg-accent-100 px-2 py-0.5 text-xs font-medium text-accent-700 dark:bg-accent-900/40 dark:text-accent-300">
                                {posts.length}
                            </span>
                        </div>
                        <div class="divide-y divide-gray-200 dark:divide-gray-700">
                            {posts.map((post) => (
                                <a
                                    href={getPostUrl(post)}
                                    data-astro-prefetch
                                    class="group flex items-center gap-3 py-3"
                                >
                                    <div class="relative aspect-video w-16 shrink-0 overflow-hidden rounded-md border border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-700">
                                        {post.data.image && (
                                            <Image
                                                src={post.data.image}
                                                alt={post.data.title}
                                                width={64}
                                                height={36}
                                                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        )}
                                    </div>
                                    <div class="min-w-0 grow">
                                        <h4 class="line-clamp-2 text-sm font-medium leading-snug text-gray-800 transition-colors duration-200 group-hover:text-accent-600 dark:text-gray-200 dark:group-hover:text-accent-400">
                                            {post.data.title}
                                        </h4>
                                        {post.data.date && (
                                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                                                {formatDate(post.data.date)}
                                            </p>
                                        )}
                                    </div>
                                </a>
                            ))}
                        </div>
                        <div class="pt-3">
                            <a
                                href={withBase(`/tags/${slug}/`)}
                                class="group inline-flex items-center text-sm font-semibold text-accent-600 transition-colors duration-200 hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300"
                            >
                                <span>
                                    View all {label} posts
                                </span>
                                <svg
                                    class="ml-1 h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14" />
                                    <path d="M12 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
)}
