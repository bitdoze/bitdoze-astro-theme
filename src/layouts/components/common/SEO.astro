---
import { siteConfig } from '@config/site';
import { safeJsonLd } from '@utils/serialize';
import { withBase } from '@utils/slug';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  indexable?: boolean;
  canonical?: string;
  publishDate?: Date;
  modifiedDate?: Date;
  author?: {
    name: string;
    url?: string;
  };
  tags?: string[];
  categories?: string[];
  // For breadcrumbs
  breadcrumbs?: Array<{name: string; url: string}>;
  // For video content
  video?: {
    src: string;
    name?: string;
    description?: string;
    thumbnailUrl?: string;
    uploadDate?: Date;
    duration?: string; // ISO 8601 format
  };
}

const {
  title = siteConfig.title, // Updated from siteConfig.name
  description = siteConfig.description,
  image = siteConfig.ogImage, // Updated from siteConfig.defaultImage
  article = false,
  indexable = true,
  canonical = Astro.url.pathname,
  publishDate,
  modifiedDate,
  author,
  tags,
  categories,
  breadcrumbs,
  video
} = Astro.props;

// Format dates for schema
const publishISODate = publishDate ? new Date(publishDate).toISOString() : null;
const modifiedISODate = modifiedDate ? new Date(modifiedDate).toISOString() : publishISODate;

// Prepare schema.org JSON-LD
let schema = null;

// Safe URL creation function
const safeUrl = (path: string, base?: URL) => {
  // Astro.site should be defined as per astro.config.mjs.
  // If base is not provided, Astro.site will be used.
  const baseToUse = base ? base.toString() : (Astro.site ? Astro.site.toString() : '');
  try {
    return new URL(path, baseToUse).toString();
  } catch (e) {
    // Fallback for cases where baseToUse might be empty or path is unusual.
    return `${baseToUse.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
  }
};

// Website schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteConfig.title, // Updated from siteConfig.name
  "url": Astro.site ? Astro.site.toString() : '', // Use Astro.site, fallback to empty if undefined
  "description": siteConfig.description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      // Use Astro.site for urlTemplate
      "urlTemplate": `${Astro.site ? Astro.site.toString().replace(/\/$/, '') : ''}/search?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

// BreadcrumbList schema
const breadcrumbsSchema = breadcrumbs ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": safeUrl(withBase(item.url), Astro.site) // Root-relative items carry the deploy base
  }))
} : null;

// VideoObject schema for pages with embedded videos
const videoSchema = video ? {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": video.name || title,
  "description": video.description || description,
  "thumbnailUrl": video.thumbnailUrl || image,
  "uploadDate": video.uploadDate ? new Date(video.uploadDate).toISOString() : publishISODate,
  "duration": video.duration || "PT0M0S",
  "contentUrl": video.src,
  "embedUrl": video.src
} : null;

// Article schema (for blog posts)
if (article && publishISODate) {
  schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": safeUrl(image, Astro.site), // Use Astro.site
    "datePublished": publishISODate,
    "dateModified": modifiedISODate || publishISODate,
    "author": author ? {
      "@type": "Person",
      "name": author.name,
      "url": author.url
    } : null,
    "publisher": {
      "@type": "Organization",
      "name": siteConfig.title, // Updated from siteConfig.name
      "logo": {
        "@type": "ImageObject",
        "url": safeUrl(withBase("/favicon.svg"), Astro.site) // Internal asset; carries the deploy base
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": safeUrl(canonical, Astro.site) // Use Astro.site
    },
    "keywords": tags?.join(", ") || "",
    "articleSection": categories?.[0],
    "inLanguage": siteConfig.lang
  };
} else if (video) {
  schema = videoSchema;
} else {
  schema = websiteSchema;
}

// Ensure canonical URL is absolute - safely create URL
let canonicalURL;
// Astro.site should be defined.
const baseSiteForCanonical = Astro.site ? Astro.site.toString() : '';
try {
  canonicalURL = new URL(canonical, baseSiteForCanonical).toString();
} catch (e) {
  // Fallback to a simple concatenation if URL constructor fails
  canonicalURL = `${baseSiteForCanonical.replace(/\/$/, '')}/${canonical.replace(/^\//, '')}`;
}
---

<!-- SEO Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={(() => {
  // Astro.site should be defined.
  const baseSiteForOgImage = Astro.site ? Astro.site.toString() : '';
  try {
    return new URL(withBase(image), baseSiteForOgImage).toString();
  } catch (e) {
    return `${baseSiteForOgImage.replace(/\/$/, '')}/${image.replace(/^\//, '')}`;
  }
})()} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content={siteConfig.locale} />

{article && publishISODate && (
  <meta property="article:published_time" content={publishISODate} />
)}

{article && modifiedISODate && (
  <meta property="article:modified_time" content={modifiedISODate} />
)}

{article && tags && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={(() => {
  // Astro.site should be defined.
  const baseSiteForTwitterImage = Astro.site ? Astro.site.toString() : '';
  try {
    return new URL(withBase(image), baseSiteForTwitterImage).toString();
  } catch (e) {
    return `${baseSiteForTwitterImage.replace(/\/$/, '')}/${image.replace(/^\//, '')}`;
  }
})()} />

<!-- Robots Meta -->
<meta name="robots" content={indexable ? "index, follow" : "noindex, follow"} />

<!-- RSS Feed autodiscovery -->
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS Feed`} href={withBase("/rss.xml")} />
<link rel="feed" type="application/rss+xml" title={`${siteConfig.title} RSS Feed`} href={withBase("/rss.xml")} />

<!-- Schema.org JSON-LD -->
<!-- safeJsonLd escapes `<`, U+2028/U+2029 for the <script> context. Trust boundary:
     repository MDX/config are trusted build input; this defends against markup-breaking
     content, not hostile authors. -->
<script is:inline type="application/ld+json" set:html={safeJsonLd(schema)} />

<!-- BreadcrumbList Schema (if breadcrumbs are provided) -->
{breadcrumbsSchema && (
  <script is:inline type="application/ld+json" set:html={safeJsonLd(breadcrumbsSchema)} />
)}

<!-- VideoObject Schema (if video is provided) -->
{videoSchema && article && (
  <script is:inline type="application/ld+json" set:html={safeJsonLd(videoSchema)} />
)}
