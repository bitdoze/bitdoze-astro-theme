---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import menu from "@config/menu.json";
import social from "@config/social.json";
import { siteConfig } from "@config/site";
import { getPostUrl, withBase } from "@utils/slug";
import { getLatestPosts } from "@utils/content";

const socialLinks = Object.entries(social).filter(([_, url]) => url);

// Icon names that differ from the config key, with a neutral fallback so a
// configured profile never renders a missing icon.
const iconMap: Record<string, string> = {
  website: 'mdi:web',
  address: 'mdi:map-marker',
};

const footerMenu = menu.footer;
const recentPosts = await getLatestPosts(3);
const year = new Date().getFullYear();
---

<footer class="mt-10 border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800/40">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1.3fr]">
      <!-- Brand -->
      <div class="max-w-sm">
        <Image
          src={siteConfig.logo}
          alt={siteConfig.logoText}
          width={siteConfig.logoWidth}
          height={siteConfig.logoHeight}
        />
        <p class="mt-4 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
          {siteConfig.footerDescription}
        </p>
        {socialLinks.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {socialLinks.map(([platform, url]) => {
              const isBluesky = (url as string).includes('bsky.app');
              return (
                <a
                  href={url as string}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={platform}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white text-gray-500 transition-colors hover:border-accent-200 hover:bg-accent-50 hover:text-accent-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:border-accent-800 dark:hover:bg-accent-900/30 dark:hover:text-accent-400"
                >
                  {isBluesky ? (
                    <svg class="w-5 h-5" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
                      <path d="M111.8 62.2C170.2 105.9 233 194.7 256 242.4c23-47.6 85.8-136.4 144.2-180.2c42.1-31.6 110.3-56 110.3 21.8c0 15.5-8.9 130.5-14.1 149.2C478.2 298 412 314.6 353.1 304.5c102.9 17.5 129.1 75.5 72.5 133.5c-107.4 110.2-154.3-27.6-166.3-62.9l0 0c-1.7-4.9-2.6-7.8-3.3-7.8s-1.6 3-3.3 7.8l0 0c-12 35.3-59 173.1-166.3 62.9c-56.5-58-30.4-116 72.5-133.5C100 314.6 33.8 298 15.7 233.1C10.4 214.4 1.5 99.4 1.5 83.9c0-77.8 68.2-53.4 110.3-21.8z"/>
                    </svg>
                  ) : (
                    <Icon name={iconMap[platform] || `mdi:${platform}`} class="w-5 h-5" />
                  )}
                </a>
              );
            })}
          </div>
        )}
      </div>

      <!-- Explore -->
      <nav aria-label="Footer">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">{siteConfig.footer.exploreTitle}</h2>
        <ul class="mt-4 space-y-2.5">
          {footerMenu.map((item) => (
            <li>
              <a
                href={withBase(item.url)}
                class="group inline-flex items-center gap-2 text-sm text-gray-600 transition-colors hover:text-accent-600 dark:text-gray-400 dark:hover:text-accent-400"
              >
                <span class="h-1 w-1 shrink-0 rounded-full bg-gray-300 transition-colors group-hover:bg-accent-500 dark:bg-gray-600 dark:group-hover:bg-accent-400"></span>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Latest Posts -->
      <div>
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">{siteConfig.footer.latestTitle}</h2>
        <div class="mt-4 space-y-4">
          {recentPosts.map((post) => (
            <a href={getPostUrl(post)} class="group flex items-center gap-3">
              {post.data.image && (
                <Image
                  src={post.data.image}
                  alt=""
                  width={64}
                  height={48}
                  class="h-12 w-16 shrink-0 rounded-md object-cover"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="text-sm font-medium leading-snug text-gray-700 transition-colors group-hover:text-accent-600 dark:text-gray-300 dark:group-hover:text-accent-400 line-clamp-2">
                {post.data.title}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-200 dark:border-gray-800">
    <div class="max-w-5xl mx-auto flex flex-col items-center justify-between gap-3 px-4 py-6 text-sm text-gray-500 dark:text-gray-400 sm:flex-row sm:px-6 lg:px-8">
      <p>&copy; {year} {siteConfig.brandName}. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a
          href={withBase("/rss.xml")}
          class="inline-flex items-center gap-1.5 transition-colors hover:text-accent-600 dark:hover:text-accent-400"
        >
          <Icon name="mdi:rss" class="h-4 w-4" />
          RSS
        </a>
        <a
          href="#main-content"
          class="inline-flex items-center gap-1.5 transition-colors hover:text-accent-600 dark:hover:text-accent-400"
        >
          <Icon name="mdi:arrow-up" class="h-4 w-4" />
          Back to top
        </a>
      </div>
    </div>
  </div>
</footer>
