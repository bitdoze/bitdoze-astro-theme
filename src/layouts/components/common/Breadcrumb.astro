---
import { Icon } from 'astro-icon/components';
import { withBase } from '@utils/slug';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
  className?: string;
}

const { items, className = "" } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`breadcrumb ${className}`}>
  <ol class="flex items-center gap-1 text-xs md:gap-1.5 md:text-sm">
    {items.map((item, index) => {
      const isCurrent = index === items.length - 1;
      // Middle crumbs only exist on md+; on mobile the trail collapses to
      // "Home / current" so the current label is never clipped mid-word.
      const isMiddleCrumb = index > 0 && !isCurrent;
      return (
        <li class:list={["flex min-w-0 items-center", isMiddleCrumb && "hidden md:flex"]}>
          {index > 0 && (
            <Icon
              name="mdi:chevron-right"
              class="mr-1 h-3.5 w-3.5 shrink-0 text-gray-400 dark:text-gray-500 md:mr-1.5 md:h-4 md:w-4"
            />
          )}
          {isCurrent ? (
            <span
              class="truncate font-semibold text-gray-900 dark:text-white"
              aria-current="page"
              title={item.name}
            >
              {item.name}
            </span>
          ) : (
            <a
              href={withBase(item.url)}
              class="inline-flex items-center gap-1 whitespace-nowrap rounded-md px-1.5 py-0.5 font-medium text-accent-600 transition-colors hover:bg-accent-50 hover:text-accent-700 dark:text-accent-400 dark:hover:bg-accent-900/30 dark:hover:text-accent-300 md:px-2 md:py-1"
            >
              {index === 0 && (
                <Icon name="mdi:home" class="h-3.5 w-3.5 shrink-0 md:h-4 md:w-4" />
              )}
              <span>{item.name}</span>
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb {
    margin-bottom: 1.5rem;
  }
</style>
