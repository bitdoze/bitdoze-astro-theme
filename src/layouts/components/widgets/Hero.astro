---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import social from '@config/social.json';
import { siteConfig } from '@config/site';
import { formatDate } from '@utils/date';
import { getPostUrl } from '@utils/slug';
import { withBase } from '@utils/slug';
import { getReadingTime } from '@utils/readingTime';
import type { PostEntry } from '@utils/content';

interface Props {
  /** Newest published post; omitted when the blog is empty. */
  post?: PostEntry;
  stats: {
    guides: number;
    topics: number;
    authors: number;
  };
  /** Only offer the in-page jump when a Learning Paths section actually renders. */
  hasLearningPaths?: boolean;
}

const { post, stats, hasLearningPaths = false } = Astro.props;

const socialLinks = Object.entries(social).filter(([_, url]) => url?.trim());

const iconMap: Record<string, string> = {
  facebook: 'mdi:facebook', twitter: 'mdi:twitter', instagram: 'mdi:instagram',
  youtube: 'mdi:youtube', linkedin: 'mdi:linkedin', github: 'mdi:github',
  reddit: 'mdi:reddit', whatsapp: 'mdi:whatsapp', email: 'mdi:email'
};

const readingTime = post && typeof post.body === 'string'
  ? getReadingTime(post.body)
  : undefined;
const featuredUrl = post ? getPostUrl(post) : withBase('/blog/');
---

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
{post ? (
  <section class="py-12 md:py-16 lg:py-20">
    <div class="grid lg:grid-cols-[minmax(0,1.02fr)_minmax(0,0.98fr)] gap-12 lg:gap-10 items-center">
      <!-- Copy -->
      <div class="max-w-xl">
        <h1 class="text-4xl sm:text-5xl font-bold leading-[1.08] tracking-[-0.02em] text-balance text-gray-900 dark:text-white">
          Modern web guides that <span class="text-accent-600 dark:text-accent-400">actually ship</span>
        </h1>

        <p class="mt-5 text-lg sm:text-xl leading-relaxed text-pretty text-gray-600 dark:text-gray-300">
          {siteConfig.heroDescription}
        </p>

        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
          <li class="inline-flex items-center gap-1.5">
            <Icon name="mdi:book-open-page-variant-outline" class="w-4 h-4 text-accent-600 dark:text-accent-400" />
            {stats.guides} practical guides
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="mdi:tag-outline" class="w-4 h-4 text-accent-600 dark:text-accent-400" />
            {stats.topics} topics to explore
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="mdi:account-group-outline" class="w-4 h-4 text-accent-600 dark:text-accent-400" />
            {stats.authors} {stats.authors === 1 ? 'author' : 'authors'} writing
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href={withBase("/blog/")}
            class="group inline-flex items-center gap-2 rounded-lg bg-accent-600 px-6 py-3 text-base font-semibold text-white shadow-md transition-all duration-200 hover:bg-accent-700 hover:shadow-lg hover:-translate-y-px"
          >
            Browse articles
            <Icon
              name="mdi:arrow-right"
              class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5"
            />
          </a>
          {hasLearningPaths && (
            <a
              href="#learning-paths"
              class="group inline-flex items-center gap-1.5 text-base font-semibold text-gray-700 transition-colors duration-200 hover:text-accent-600 dark:text-gray-300 dark:hover:text-accent-400"
            >
              <Icon
                name="mdi:map-marker-path"
                class="w-5 h-5 text-accent-600 dark:text-accent-400"
              />
              Find your path
              <Icon
                name="mdi:arrow-down"
                class="w-4 h-4 transition-transform duration-200 group-hover:translate-y-0.5"
              />
            </a>
          )}
        </div>

        {socialLinks.length > 0 && (
          <div class="mt-8 flex items-center gap-1">
            <span class="mr-2 text-xs text-gray-500 dark:text-gray-400">Follow along</span>
            {socialLinks.map(([platform, url]) => {
              const isBluesky = (url as string).includes('bsky.app');
              return (
                <a
                  href={url as string}
                  class="inline-flex h-9 w-9 items-center justify-center rounded-md text-gray-500 transition-colors duration-200 hover:text-accent-600 dark:text-gray-400 dark:hover:text-accent-400"
                  aria-label={platform}
                >
                  {isBluesky ? (
                    <svg class="w-5 h-5" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
                      <path d="M111.8 62.2C170.2 105.9 233 194.7 256 242.4c23-47.6 85.8-136.4 144.2-180.2c42.1-31.6 110.3-56 110.3 21.8c0 15.5-8.9 130.5-14.1 149.2C478.2 298 412 314.6 353.1 304.5c102.9 17.5 129.1 75.5 72.5 133.5c-107.4 110.2-154.3-27.6-166.3-62.9l0 0c-1.7-4.9-2.6-7.8-3.3-7.8s-1.6 3-3.3 7.8l0 0c-12 35.3-59 173.1-166.3 62.9c-56.5-58-30.4-116 72.5-133.5C100 314.6 33.8 298 15.7 233.1C10.4 214.4 1.5 99.4 1.5 83.9c0-77.8 68.2-53.4 110.3-21.8z"/>
                    </svg>
                  ) : (
                    <Icon name={iconMap[platform] || 'mdi:link'} class="w-5 h-5" />
                  )}
                </a>
              );
            })}
          </div>
        )}
      </div>

      <!-- Featured post -->
      <article class="group w-full lg:justify-self-end">
        <a href={featuredUrl} data-astro-prefetch class="block overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
          {post.data.image && (
            <div class={`relative aspect-video overflow-hidden ${post.data.imageFit === "contain" ? "bg-gray-50 dark:bg-gray-900" : ""}`}>
              <Image
                src={post.data.image}
                alt={post.data.imageAlt ?? post.data.title}
                class={`h-full w-full transition-[filter] duration-300 group-hover:brightness-105 ${post.data.imageFit === "contain" ? "object-contain" : "object-cover"}`}
                width={960}
                height={540}
                widths={[480, 640, 960]}
                sizes="(max-width: 1024px) 100vw, 50vw"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
              <span class="absolute left-3 top-3 rounded-full bg-accent-600 px-3 py-1 text-xs font-semibold text-white shadow-sm">
                Latest
              </span>
            </div>
          )}
          <div class="p-5 sm:p-6">
            {post.data.categories?.[0] && (
              <span class="inline-block text-xs font-medium px-2 py-1 bg-accent-100 dark:bg-accent-900 text-accent-700 dark:text-accent-300 rounded-full mb-3">
                {post.data.categories[0]}
              </span>
            )}
            <h2 class="text-xl sm:text-2xl font-bold text-balance text-gray-900 dark:text-white line-clamp-2 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
              {post.data.title}
            </h2>
            {post.data.description && (
              <p class="mt-2 text-sm sm:text-base leading-relaxed text-gray-600 dark:text-gray-300 line-clamp-2">
                {post.data.description}
              </p>
            )}
            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
              {post.data.authors?.[0] && <span>{post.data.authors[0]}</span>}
              {post.data.date && (
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              )}
              {readingTime && (
                <span>{readingTime.minutes > 0 ? readingTime.minutes : 1} min read</span>
              )}
            </div>
          </div>
        </a>
      </article>
    </div>
  </section>
) : (
  <section class="py-12 md:py-20 text-center">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-gray-900 dark:text-white">
      Welcome to <span class="text-accent-600 dark:text-accent-400">{siteConfig.brandName}</span>
    </h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-8">
      {siteConfig.heroDescription}
    </p>
    <a
      href={withBase("/blog/")}
      class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-6 py-3 text-base font-semibold text-white shadow-md transition-all duration-200 hover:bg-accent-700 hover:shadow-lg"
    >
      Browse articles
      <Icon name="mdi:arrow-right" class="w-5 h-5" />
    </a>
  </section>
)}
</div>
