---
interface Props {
  type?: 'info' | 'success' | 'warning' | 'error';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const styles = {
  info: { bg: 'bg-info-50 dark:bg-info-900/30 border-info-400', text: 'text-info-800 dark:text-info-200', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  success: { bg: 'bg-success-50 dark:bg-success-900/30 border-success-400', text: 'text-success-800 dark:text-success-200', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  warning: { bg: 'bg-warning-50 dark:bg-warning-900/30 border-warning-400', text: 'text-warning-800 dark:text-warning-200', icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z' },
  error: { bg: 'bg-danger-50 dark:bg-danger-900/30 border-danger-400', text: 'text-danger-800 dark:text-danger-200', icon: 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z' }
};

const s = styles[type];
---

<div class={`not-prose p-4 my-6 rounded-lg border ${s.bg}`}>
  <div class={`flex items-start gap-3 ${s.text}`}>
    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/>
    </svg>
    <div>
      {title && <p class="font-semibold mb-1">{title}</p>}
      <div class="prose dark:prose-invert max-w-none [&>p]:m-0">
        <slot />
      </div>
    </div>
  </div>
</div>
