---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '@layouts/Layout.astro';
import { formatDate } from '@utils/date';
import PostHeadings from '@layouts/components/table-of-contents/PostHeadings.astro';
import RelatedPosts from '@layouts/components/blog/RelatedPosts.astro';
import SocialShare from '@layouts/components/blog/SocialShare.astro';
import SeriesNav from '@layouts/components/widgets/SeriesNav.astro';
import ReadingProgress from '@layouts/components/blog/ReadingProgress.astro';
import Breadcrumb from '@layouts/components/common/Breadcrumb.astro';
import { entryIdToSlug, getPostSlug, slugify, taxonomySlug, withBase } from '@utils/slug';
import { getPublishedAuthors } from '@utils/content';
import { resolveAuthor, warnUnknownAuthor } from '@utils/authors';
import { getReadingTime } from '@utils/readingTime';

const { post, headings } = Astro.props;
const { title, meta_title, description, image, imageAlt, imageFit, date, updatedDate, categories, authors, tags, series, canonical } = post.data;

const pageURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;
const canonicalURL = canonical ?? pageURL;
const primaryAuthor = authors?.[0];
const authorEntry = primaryAuthor
  ? resolveAuthor(primaryAuthor, await getPublishedAuthors())
  : undefined;
if (primaryAuthor && !authorEntry) {
  warnUnknownAuthor(primaryAuthor);
}
const schemaAuthor = primaryAuthor ? {
  name: (authorEntry?.data.title ?? primaryAuthor) as string,
  url: Astro.site ? new URL(withBase('/authors/' + slugify(primaryAuthor) + '/'), Astro.site).toString() : undefined,
} : undefined;

const authorProfile = primaryAuthor
  ? {
      name: ((authorEntry?.data.title ?? primaryAuthor) as string),
      image: authorEntry?.data.image ? withBase(authorEntry.data.image) : undefined,
      bio: authorEntry?.data.description,
      url: withBase('/authors/' + slugify(authorEntry ? entryIdToSlug(authorEntry) : primaryAuthor) + '/'),
    }
  : undefined;

const readingTime = getReadingTime(typeof post.body === 'string' ? post.body : '');
const showUpdated = Boolean(updatedDate && date && updatedDate.toDateString() !== date.toDateString());

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  ...(categories?.length ? [{ name: categories[0], url: `/categories/${taxonomySlug(categories[0])}/` }] : []),
  { name: title, url: pageURL }
];

const hasSeries = Boolean(series);
---

<Layout
  title={meta_title ?? title}
  description={description}
  image={image?.src}
  article={true}
  canonical={canonicalURL}
  publishDate={date}
  modifiedDate={updatedDate}
  author={schemaAuthor}
  tags={tags}
  categories={categories}
  breadcrumbs={breadcrumbs}
  video={post.data.video ? { src: post.data.video } : undefined}
  wideContent={true}
>
  <ReadingProgress />

  <div class="w-full py-8">
    <!-- Content + right-rail TOC grid; the rail only exists at xl and up -->
    <div
      class="mx-auto max-w-3xl xl:max-w-[64rem] 2xl:max-w-[68rem] px-4 sm:px-6 xl:grid xl:grid-cols-[minmax(0,1fr)_16rem] 2xl:grid-cols-[minmax(0,1fr)_18rem] xl:gap-12"
    >
      <article class="min-w-0">
        <Breadcrumb items={breadcrumbs} className="mb-6" />

        <header class="mb-10">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-[1.1] tracking-tight text-balance text-gray-900 dark:text-white">{title}</h1>

          {description && (
            <div class="mt-6 rounded-xl border border-accent-100 bg-accent-50/60 px-5 py-4 dark:border-accent-900/60 dark:bg-accent-950/30">
              <p class="text-lg leading-relaxed text-pretty text-gray-700 dark:text-gray-200">
                {description}
              </p>
            </div>
          )}

          <!-- Meta line -->
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
            {authorProfile && (
              <a
                href={authorProfile.url}
                class="group inline-flex items-center gap-2 font-medium text-gray-700 transition-colors duration-200 hover:text-accent-600 dark:text-gray-300 dark:hover:text-accent-400"
              >
                {authorProfile.image && (
                  <img
                    src={authorProfile.image}
                    alt={authorProfile.name}
                    width="28"
                    height="28"
                    loading="lazy"
                    class="h-7 w-7 rounded-full object-cover ring-1 ring-gray-200 dark:ring-gray-700"
                  />
                )}
                {authorProfile.name}
              </a>
            )}
            {date && (
              <span class="inline-flex items-center gap-1.5">
                <Icon name="mdi:calendar" class="w-4 h-4" />
                <time datetime={date.toISOString()}>{formatDate(date)}</time>
              </span>
            )}
            {showUpdated && updatedDate && (
              <span class="inline-flex items-center gap-1.5" title="Last updated">
                <Icon name="mdi:update" class="w-4 h-4 text-accent-500 dark:text-accent-400" />
                Updated
                <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            )}
            <span class="inline-flex items-center gap-1.5">
              <Icon name="mdi:clock-outline" class="w-4 h-4" />
              {readingTime.minutes > 0 ? readingTime.minutes : 1} min read
            </span>
          </div>

          {image && (
            <div class={`mt-8 overflow-hidden rounded-lg border border-gray-200 shadow-sm aspect-video dark:border-gray-700 ${imageFit === "contain" ? "bg-gray-50 dark:bg-gray-900" : ""}`}>
              <Image src={image} alt={imageAlt ?? title} class={`w-full h-full ${imageFit === "contain" ? "object-contain" : "object-cover"}`} widths={[480, 768, 1024, 1280]} sizes="(max-width: 1280px) calc(100vw - 2rem), (max-width: 1536px) 720px, 752px" width={1280} height={720} loading="eager" decoding="async" fetchpriority="high" />
            </div>
          )}
        </header>

        {hasSeries && series && <SeriesNav currentSlug={getPostSlug(post)} seriesName={series.name} seriesPosition={series.position} />}

        <div
          class="prose prose-lg dark:prose-invert prose-headings:font-bold prose-a:text-accent-600 dark:prose-a:text-accent-400 prose-img:rounded-lg w-full max-w-none!"
          data-reading-body
        >
          <slot />
        </div>

        {tags?.length > 0 && (
          <div class="mt-10 flex flex-wrap gap-2 border-t border-gray-200 pt-6 dark:border-gray-700">
            {tags.map((tag: string) => (
              <a
                href={withBase(`/tags/${taxonomySlug(tag)}/`)}
                class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700 transition-colors duration-200 hover:bg-accent-100 hover:text-accent-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-accent-900 dark:hover:text-accent-300"
              >
                #{tag.charAt(0).toUpperCase() + tag.slice(1)}
              </a>
            ))}
          </div>
        )}

        {authorProfile && (
          <aside class="not-prose mt-8 flex items-start gap-4 rounded-lg border border-gray-200 bg-gray-50 p-5 dark:border-gray-700 dark:bg-gray-800/50">
            {authorProfile.image && (
              <img
                src={authorProfile.image}
                alt={authorProfile.name}
                width="48"
                height="48"
                loading="lazy"
                class="h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-gray-200 dark:ring-gray-700"
              />
            )}
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-900 dark:text-white">
                Written by{" "}
                <a
                  href={authorProfile.url}
                  class="text-accent-600 transition-colors duration-200 hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300"
                >
                  {authorProfile.name}
                </a>
              </p>
              {authorProfile.bio && (
                <p class="mt-1 text-sm leading-relaxed text-gray-600 dark:text-gray-400 line-clamp-3">
                  {authorProfile.bio}
                </p>
              )}
              <a
                href={authorProfile.url}
                class="group mt-2 inline-flex items-center gap-1 text-sm font-medium text-accent-600 transition-colors duration-200 hover:text-accent-700 dark:text-accent-400 dark:hover:text-accent-300"
              >
                {`More guides from ${authorProfile.name}`}
                <Icon
                  name="mdi:arrow-right"
                  class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
                />
              </a>
            </div>
          </aside>
        )}

        <SocialShare title={title} description={description} url={canonicalURL} />
        <RelatedPosts currentPost={post} />
      </article>

      <!-- Right rail: sticky TOC (xl and up) + floating TOC (below xl) -->
      <PostHeadings headings={headings} />
    </div>
  </div>

  <!-- Code block copy buttons -->
  <script>
    (() => {
      const win = window as typeof window & { __themeCodeCopyBooted?: boolean };
      const copyIcon =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const checkIcon =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

      async function copyText(text: string): Promise<boolean> {
        if (typeof navigator !== "undefined" && navigator.clipboard?.writeText) {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {
            // Fall through to execCommand fallback (permissions / insecure context)
          }
        }

        try {
          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.top = "0";
          textarea.style.left = "0";
          textarea.style.width = "1px";
          textarea.style.height = "1px";
          textarea.style.padding = "0";
          textarea.style.border = "none";
          textarea.style.outline = "none";
          textarea.style.boxShadow = "none";
          textarea.style.background = "transparent";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.focus();
          textarea.select();
          textarea.setSelectionRange(0, text.length);
          const ok = document.execCommand("copy");
          document.body.removeChild(textarea);
          return ok;
        } catch {
          return false;
        }
      }

      function setButtonState(
        btn: HTMLButtonElement,
        state: "idle" | "copied" | "error",
      ) {
        btn.classList.remove("copied", "copy-error");
        if (state === "copied") {
          btn.classList.add("copied");
          btn.innerHTML = checkIcon;
          btn.setAttribute("aria-label", "Copied");
        } else if (state === "error") {
          btn.classList.add("copy-error");
          btn.innerHTML = copyIcon;
          btn.setAttribute("aria-label", "Copy failed");
        } else {
          btn.innerHTML = copyIcon;
          btn.setAttribute("aria-label", "Copy code");
        }
      }

      function initCodeCopy() {
        const codeBlocks = document.querySelectorAll(".prose pre");
        codeBlocks.forEach((pre) => {
          if (!(pre instanceof HTMLElement)) return;
          if (pre.parentElement?.classList.contains("code-copy-wrapper")) return;

          const wrapper = document.createElement("div");
          wrapper.className = "code-copy-wrapper";
          pre.parentNode!.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const btn = document.createElement("button");
          btn.className = "code-copy-btn";
          btn.type = "button";
          setButtonState(btn, "idle");
          btn.addEventListener("click", async (event) => {
            event.preventDefault();
            event.stopPropagation();
            const code = pre.querySelector("code");
            const text = code?.textContent || pre.textContent || "";
            if (!text) {
              setButtonState(btn, "error");
              setTimeout(() => setButtonState(btn, "idle"), 2000);
              return;
            }
            const ok = await copyText(text);
            setButtonState(btn, ok ? "copied" : "error");
            setTimeout(() => setButtonState(btn, "idle"), 2000);
          });
          wrapper.appendChild(btn);
        });
      }

      if (!win.__themeCodeCopyBooted) {
        win.__themeCodeCopyBooted = true;
        document.addEventListener("astro:page-load", initCodeCopy);
        document.addEventListener("astro:after-swap", initCodeCopy);
      }
      initCodeCopy();
    })();
  </script>

  <style is:global>
    .code-copy-wrapper {
      position: relative;
    }
    .code-copy-btn {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      padding: 0.375rem;
      background: rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 0.375rem;
      color: rgba(255, 255, 255, 0.85);
      cursor: pointer;
      /* Always visible enough on touch; stronger on hover/focus */
      opacity: 0.85;
      transition: opacity 0.2s, background 0.2s;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    @media (hover: hover) and (pointer: fine) {
      .code-copy-btn {
        opacity: 0;
      }
      .code-copy-wrapper:hover .code-copy-btn,
      .code-copy-btn:focus,
      .code-copy-btn:focus-visible,
      .code-copy-btn.copied {
        opacity: 1;
      }
    }
    .code-copy-btn:hover {
      background: rgba(0, 0, 0, 0.65);
      color: #fff;
    }
    .code-copy-btn.copied {
      color: #4ade80;
      opacity: 1;
    }
    .code-copy-btn.copy-error {
      color: #f87171;
      opacity: 1;
    }
    .code-copy-btn:focus-visible {
      outline: 2px solid var(--color-accent-500);
      outline-offset: 2px;
      opacity: 1;
    }
    @media (prefers-reduced-motion: reduce) {
      .code-copy-btn {
        transition: none;
      }
    }
  </style>
</Layout>
